node_modules/
dist/
# WebAssembly de web-ifc: lo copia scripts/copy-web-ifc.mjs desde node_modules
public/web-ifc/
# Licencias de terceros: las genera scripts/third-party-licenses.mjs en cada dev/build
public/THIRD_PARTY_LICENSES.txt
*.log
.DS_Store

# Variables de entorno.
# .env.production SÍ se versiona: no tiene secretos, solo URLs públicas que
# acaban dentro del bundle del navegador. Es la definición del entorno y debe
# viajar con el repo. Lo que NO se versiona son las sobrescrituras locales:
.env
.env.local
.env.*.local

# Archivos de bloqueo de Word (se crean al abrir un .docx)
~$*

# Configuración local de Claude Code (no compartir)
.claude/settings.local.json
