{
  "name": "saf-planos-fabricjs",
  "version": "1.0.0",
  "description": "SAF Visor de Planos — PDF.js + Fabric.js (2D) · That Open Engine (modelo 3D IFC)",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-web-ifc.mjs && node scripts/third-party-licenses.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-web-ifc.mjs && node scripts/third-party-licenses.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "convertir-ifc": "node --max-old-space-size=8192 scripts/convertir-ifc.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/three": "0.184.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "~3.4.7",
    "fabric": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "three": "0.184.0",
    "web-ifc": "0.0.77"
  }
}
