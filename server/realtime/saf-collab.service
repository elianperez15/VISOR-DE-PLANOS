# Servicio systemd para el WebSocket de colaboración — entorno PRODUCCIÓN.
# El gemelo de desarrollo es saf-collab-dev.service (puerto 3101).
# Instalar:
#   sudo cp server/realtime/saf-collab.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now saf-collab
# Ver estado / logs:
#   systemctl status saf-collab
#   journalctl -u saf-collab -f
[Unit]
Description=SAF Planos (PROD) — WebSocket de colaboración en tiempo real
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Debe coincidir con PROD_COLLAB_DIR de scripts/deploy.sh
WorkingDirectory=/var/www/saf/planos/server/realtime
ExecStart=/usr/bin/node collab-server.js
Restart=always
RestartSec=3

# ── Variables de entorno del entorno PROD ───────────────────────────────
# Puerto 3100 (dev usa 3101).
Environment=COLLAB_PORT=3100
Environment=COLLAB_ORIGINS=https://planos.aicsacorp.com

# Endurecimiento básico
User=planos
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
