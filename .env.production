# ──────────────────────────────────────────────────────────────────────
# Variables del visor — se cargan con `npm run build` (modo production).
#
# Se versiona en git a propósito: NO contiene secretos, solo URLs públicas que
# ya viajan dentro del bundle del navegador. Las sobrescrituras locales de cada
# máquina van en .env.local, que sí está ignorado.
# ──────────────────────────────────────────────────────────────────────

# Ruta RELATIVA: nginx reenvía /ords/ al ORDS real (ver server/nginx-prod.conf).
# Así no hay dominios quemados en el bundle ni CORS, y mover ORDS es editar
# nginx y recargar — sin recompilar el visor.
VITE_ORDS_BASE=/ords/safws

# Origen del portal APEX aceptado en postMessage (seguridad). Debe ser el MISMO
# host al que nginx reenvía /ords/: APEX corre sobre ORDS y es quien manda los
# id_en_repositorio. Ver docs/DESPLIEGUE.md → "Los tres hostnames".
#
# ⚠️  APUNTANDO A DESARROLLO (temporal, 2026-09-22).
#     Para volver a producción son DOS cambios que van juntos:
#       1. aquí:      VITE_APEX_ORIGIN=https://saf.aicsacorp.com  + npm run deploy
#       2. en nginx:  set $ords_upstream "saf.aicsacorp.com";     + reload
#     Cambiar solo uno deja el visor buscando IDs de una base en la otra.
VITE_APEX_ORIGIN=https://dev.aicsacorp.com

# ── Colaboración en tiempo real ───────────────────────────────────────
# false → el visor NO abre el WebSocket: sin cursores de otros, sin ver
# marcas ajenas en vivo, sin panel de colaboradores, y SIN el bucle de
# reintentos de conexión (que si no reintenta cada 8 s indefinidamente).
#
# NO afecta a la persistencia: guardar/cargar marcas, la calibración de
# escala y la rotación viajan por HTTP contra ORDS, no por el WebSocket.
# Para reactivarla: pon true y `npm run deploy`. El microservicio
# saf-collab sigue instalado y corriendo en el servidor, listo para
# cuando se necesite.
VITE_COLLAB_ENABLED=false
